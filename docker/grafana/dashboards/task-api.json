{
  "title": "Task API (local)",
  "uid": "task-api",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate by instance (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{instance}}",
        "expr": "sum by (instance) (rate(app_http_requests_total[1m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(app_http_request_duration_seconds_bucket[1m])))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "5xx error rate (req/s)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "5xx",
        "expr": "sum(rate(app_http_requests_total{status=~\"5..\"}[1m]))" }]
    },
    {
      "id": 4, "type": "stat", "title": "Healthy app targets",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"app\"} == 1)" }]
    }
  ]
}
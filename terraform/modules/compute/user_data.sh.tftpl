#!/bin/bash
# Boot script for app instances. Rendered by Terraform; contains no secrets.
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

%{ if app_container_image != "" ~}
docker run -d --name task-api --restart unless-stopped \
  -p ${app_port}:8000 \
  --log-driver awslogs \
  --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group_name} \
  ${app_container_image}
%{ else ~}
echo "No app_container_image configured: this instance will fail the load balancer health check."
%{ endif ~}
